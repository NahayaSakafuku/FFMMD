<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
		<!-- 直接编译插件里的纯 .NET 解析层，离线验证 VMD 解析/采样，不进游戏。 -->
		<Compile Include="..\FFMMD\Vmd\**\*.cs" Link="Vmd\%(Filename)%(Extension)" />
		<Compile Include="..\FFMMD\Posing\SkeletonData.cs" Link="Posing\SkeletonData.cs" />
        <Compile Include="..\FFMMD\Retarget\*.cs" Exclude="..\FFMMD\Retarget\Retargeter.cs;..\FFMMD\Retarget\BoneMap.cs" Link="Retarget\%(Filename)%(Extension)" />
		<Compile Include="..\FFMMD\Retarget\BoneMap.cs" Link="Retarget\BoneMap.cs" />
		<Compile Include="..\FFMMD\Configuration.cs" Link="Configuration.cs" />
		<Compile Include="..\FFMMD\Player\AudioTransportLogic.cs" Link="Player\AudioTransportLogic.cs" />
		<Compile Include="..\FFMMD\Player\VariableSpeedSampler.cs" Link="Player\VariableSpeedSampler.cs" />
	</ItemGroup>
</Project>
